{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/p9.html" },
    { "src": "/p9", "dest": "/p9.html" },
    { "src": "/p9.html", "dest": "/p9.html" },
    { "src": "/p9/policy", "dest": "/p9-policy.html" },
    { "src": "/p9/terms", "dest": "/p9-terms.html" },
    { "src": "/it-kolledzhi", "dest": "/it-obzor.html" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/demo", "dest": "/demo.html" },
    { "src": "/demo.html", "dest": "/demo.html" },
    { "src": "/game", "dest": "/game.html" },
    { "src": "/game.html", "dest": "/game.html" },
    { "src": "/proftest", "dest": "/proftest.html" },
    { "src": "/proftest.html", "dest": "/proftest.html" },
    { "src": "/test", "dest": "/test.html" },
    { "src": "/test.html", "dest": "/test.html" },
    { "src": "/things/(.*)", "dest": "https://stranger-quiz.vercel.app/$1" },
    { "src": "/things", "dest": "https://stranger-quiz.vercel.app/" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

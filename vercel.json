{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/p9.html"
    },
    {
      "src": "/p9",
      "dest": "/p9.html"
    },
    {
      "src": "/p9.html",
      "dest": "/p9.html"
    },
    {
      "src": "/p9/policy",
      "status": 308,
      "headers": {
        "Location": "https://posle-9.ru/policy"
      }
    },
    {
      "src": "/p9/terms",
      "status": 308,
      "headers": {
        "Location": "https://posle-9.ru/terms"
      }
    },
    {
      "src": "/it-kolledzhi",
      "dest": "/it-obzor.html"
    },
    {
      "src": "/logo.png",
      "dest": "/logo.png"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/game",
      "dest": "/game.html"
    },
    {
      "src": "/game.html",
      "dest": "/game.html"
    },
    {
      "src": "/proftest",
      "dest": "/proftest.html"
    },
    {
      "src": "/proftest.html",
      "dest": "/proftest.html"
    },
    {
      "src": "/things/(.*)",
      "dest": "https://stranger-quiz.vercel.app/$1"
    },
    {
      "src": "/things",
      "dest": "https://stranger-quiz.vercel.app/"
    },
    {
      "src": "/(demo|demo\\.html|test|test\\.html)",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
